@page "/forgot-password"
@layout Layout.AuthLayout
@using Banking_System.Web.Models.Authentication
@using Banking_System.Web.Services.Authentication
@inject AuthApiClient AuthApi

<PageTitle>Forgot password | SecureBank</PageTitle>

<div class="auth-card">
    <h1>Forgot your password?</h1>
    <p class="text-muted mb-4">
        Enter your username, email address or phone number. We will email a link to the address on
        your account so you can choose a new password.
    </p>

    @if (_unavailable)
    {
        <div class="alert alert-danger" role="alert">
            The banking API is unavailable. Try again in a moment.
        </div>
    }

    @if (_sent)
    {
        <div class="alert alert-success" role="alert">
            If an online-banking account matches, we have emailed it a password reset link. It works
            once and expires in 30 minutes. Check your spam folder if it does not arrive.
        </div>

        @if (_devLink is not null)
        {
            <div class="alert alert-warning" role="alert">
                <strong>Development mode:</strong> no mail server is connected, so here is the link that
                would have been emailed:
                <div class="mt-2 text-break"><a href="@_devLink">@_devLink</a></div>
            </div>
        }
    }
    else
    {
        <EditForm Model="Input" FormName="forgot-password" OnValidSubmit="SubmitAsync" method="post" novalidate>
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label" for="identifier">Username, email or phone number</label>
                <InputText class="form-control" id="identifier" @bind-Value="Input!.Identifier"
                           autocomplete="username" autocapitalize="none" spellcheck="false" />
                <ValidationMessage For="() => Input!.Identifier" />
            </div>

            <button class="btn btn-primary w-100" type="submit">Email me a reset link</button>
        </EditForm>
    }

    <hr class="my-4" />

    <p class="mb-1 text-center">
        <a href="/forgot-username" class="text-decoration-none">Forgot your username instead?</a>
    </p>
    <p class="mb-0 text-center">
        <a href="/login" class="text-decoration-none">Back to sign in</a>
    </p>
</div>

@code {
    [SupplyParameterFromForm(FormName = "forgot-password")]
    private ForgotPasswordInput? Input { get; set; }

    private bool _sent;
    private bool _unavailable;
    private string? _devLink;

    protected override void OnInitialized() => Input ??= new ForgotPasswordInput();

    private async Task SubmitAsync()
    {
        _unavailable = false;

        try
        {
            var result = await AuthApi.ForgotPasswordAsync(Input!.Identifier.Trim());
            _devLink = result.Data?.DevResetLink;
            _sent = true;
        }
        catch (HttpRequestException)
        {
            _unavailable = true;
        }
    }
}
