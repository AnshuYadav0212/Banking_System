@page "/employee/tickets"
@attribute [Authorize(Roles = "Employee,Admin")]
@using System.Globalization
@using Microsoft.AspNetCore.Authentication
@using Banking_System.Web.Authentication
@using Banking_System.Web.Models.Tickets
@using Banking_System.Web.Services.Tickets
@inject TicketApiClient Tickets

<PageTitle>Ticket queue | SecureBank</PageTitle>

<div class="container py-4 transfer-page queue-page">
    <div class="queue-header">
        <h1>Support ticket queue</h1>
        <p class="text-muted mb-0">Every customer support ticket, high priority first.</p>
    </div>

    @if (_sessionExpired)
    {
        <div class="alert alert-warning" role="alert">
            Your session has expired. <a href="/login" class="alert-link">Sign in again</a>.
        </div>
    }
    else if (_unavailable)
    {
        <div class="alert alert-danger" role="alert">
            The banking API is unavailable. Try again in a moment.
        </div>
    }
    else
    {
        @* A plain GET form: static server rendering has no @@onchange, so the
           dropdowns submit it with a one-line inline handler and the filters live in the URL. *@
        <form method="get" action="/employee/tickets" class="queue-filters card">
            <div class="queue-search">
                <label class="form-label" for="q">Search</label>
                <input class="form-control" id="q" name="q" type="search" value="@Search"
                       placeholder="Subject, ticket ID (TCK-…) or assignee" autocomplete="off" />
            </div>

            <div class="queue-select">
                <label class="form-label" for="status">Status</label>
                <select class="form-select" id="status" name="status" onchange="this.form.submit()">
                    <option value="" selected="@(Status is null)">All statuses</option>
                    @foreach (var s in TicketStatuses.All)
                    {
                        <option value="@s.Code" selected="@(Status == s.Code)">@s.Label</option>
                    }
                </select>
            </div>

            <div class="queue-select">
                <label class="form-label" for="category">Category</label>
                <select class="form-select" id="category" name="category" onchange="this.form.submit()">
                    <option value="" selected="@(Category is null)">All categories</option>
                    @foreach (var c in TicketCategories.All)
                    {
                        <option value="@CategoryCode(c.Id)" selected="@(Category == CategoryCode(c.Id))">@c.Label</option>
                    }
                </select>
            </div>

            <div class="queue-actions">
                <button class="btn btn-primary" type="submit">Search</button>
                @if (HasFilters)
                {
                    <a class="btn btn-outline-secondary" href="/employee/tickets">Clear</a>
                }
            </div>
        </form>

        @if (_matches.Count == 0)
        {
            <div class="card queue-empty">
                <p class="text-muted mb-0">No tickets match these filters.</p>
            </div>
        }
        else
        {
            <div class="card queue-table-card">
                <p class="table-scroll-hint">&larr; Swipe to see more &rarr;</p>
                <div class="table-responsive">
                    <table class="table queue-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Ticket</th>
                                <th>Category</th>
                                <th>Priority</th>
                                <th>Status</th>
                                <th>Assigned to</th>
                                <th>Created</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in _pageItems)
                            {
                                <tr>
                                    <td class="queue-subject">
                                        <a href="/tickets/@t.TicketId" class="queue-link">@t.Subject</a>
                                        <div class="text-muted small">#@Ref(t.TicketId)</div>
                                    </td>
                                    <td><span class="queue-chip">@TicketCategories.Label(t.Category)</span></td>
                                    <td>
                                        <span class="queue-priority queue-priority-@t.Priority.ToLowerInvariant()">
                                            <span class="queue-dot"></span>@t.Priority
                                        </span>
                                    </td>
                                    <td><span class="badge @TicketStatuses.BadgeClass(t.Status)">@TicketStatuses.Label(t.Status)</span></td>
                                    <td>
                                        @if (t.AssignedToUsername is { } who)
                                        {
                                            <span class="queue-assignee">
                                                <span class="queue-avatar">@char.ToUpperInvariant(who[0])</span>@who
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Unassigned</span>
                                        }
                                    </td>
                                    <td class="text-nowrap">@Time(t.CreatedAt)</td>
                                    <td class="text-end">
                                        <a class="btn btn-sm btn-outline-secondary" href="/tickets/@t.TicketId">View</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="queue-footer">
                    <span class="text-muted small">
                        Showing @(_offset + 1)–@(_offset + _pageItems.Count) of @_matches.Count
                        @(_matches.Count == 1 ? "ticket" : "tickets")
                    </span>

                    @if (_pageCount > 1)
                    {
                        <nav class="queue-pager" aria-label="Ticket pages">
                            <a class="btn btn-sm btn-outline-secondary @(_page <= 1 ? "disabled" : "")"
                               href="@PageHref(_page - 1)" aria-label="Previous page">&lsaquo;</a>
                            @for (var p = 1; p <= _pageCount; p++)
                            {
                                <a class="btn btn-sm @(p == _page ? "btn-primary" : "btn-outline-secondary")"
                                   href="@PageHref(p)">@p</a>
                            }
                            <a class="btn btn-sm btn-outline-secondary @(_page >= _pageCount ? "disabled" : "")"
                               href="@PageHref(_page + 1)" aria-label="Next page">&rsaquo;</a>
                        </nav>
                    }
                </div>
            </div>
        }
    }
</div>

@code {
    private const int PageSize = 10;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [SupplyParameterFromQuery(Name = "status")]
    private string? Status { get; set; }

    [SupplyParameterFromQuery(Name = "category")]
    private string? Category { get; set; }

    [SupplyParameterFromQuery(Name = "q")]
    private string? Search { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    private int? PageNumber { get; set; }

    private static readonly Dictionary<Guid, string> CategoryCodes = new()
    {
        [Banking_System.Web.Models.Tickets.TicketCategoryIds.TransactionDispute] = "TransactionDispute",
        [Banking_System.Web.Models.Tickets.TicketCategoryIds.TransactionIssue] = "TransactionIssue",
        [Banking_System.Web.Models.Tickets.TicketCategoryIds.Security] = "Security",
        [Banking_System.Web.Models.Tickets.TicketCategoryIds.General] = "General"
    };

    private List<TicketSummary> _matches = [];
    private List<TicketSummary> _pageItems = [];
    private int _page = 1;
    private int _pageCount = 1;
    private int _offset;
    private bool _sessionExpired;
    private bool _unavailable;

    private bool HasFilters =>
        !string.IsNullOrEmpty(Status) || !string.IsNullOrEmpty(Category) || !string.IsNullOrWhiteSpace(Search);

    protected override async Task OnInitializedAsync()
    {
        // The dropdowns submit "" for "All"; treat that the same as no filter.
        Status = string.IsNullOrEmpty(Status) ? null : Status;
        Category = string.IsNullOrEmpty(Category) ? null : Category;

        var token = HttpContext is null ? null : await HttpContext.GetTokenAsync(BankingTokens.AccessToken);

        if (string.IsNullOrEmpty(token))
        {
            _sessionExpired = true;
            return;
        }

        try
        {
            var statusId = TicketStatuses.ToId(Status);
            var categoryId = CategoryCodes.Where(kv => kv.Value == Category).Select(kv => (Guid?)kv.Key).FirstOrDefault();

            var result = await Tickets.GetQueueAsync(token, statusId, categoryId);

            if (result.Error == "Unauthorized")
            {
                _sessionExpired = true;
                return;
            }

            _matches = Filter(result.Data ?? [], Search);
        }
        catch (HttpRequestException)
        {
            _unavailable = true;
            return;
        }

        _pageCount = Math.Max(1, (int)Math.Ceiling(_matches.Count / (double)PageSize));
        _page = Math.Clamp(PageNumber ?? 1, 1, _pageCount);
        _offset = (_page - 1) * PageSize;
        _pageItems = _matches.Skip(_offset).Take(PageSize).ToList();
    }

    // The queue is capped at 200 tickets by the API, so the text search runs here.
    private static List<TicketSummary> Filter(List<TicketSummary> all, string? search)
    {
        var term = search?.Trim().TrimStart('#');

        if (string.IsNullOrEmpty(term))
        {
            return all;
        }

        return all.Where(t =>
                t.Subject.Contains(term, StringComparison.OrdinalIgnoreCase)
                || Ref(t.TicketId).Contains(term, StringComparison.OrdinalIgnoreCase)
                || (t.AssignedToUsername?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                || TicketCategories.Label(t.Category).Contains(term, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    private static string CategoryCode(Guid id) => CategoryCodes.TryGetValue(id, out var code) ? code : "";

    private string PageHref(int page)
    {
        var parts = new[]
        {
            Status is null ? null : $"status={Uri.EscapeDataString(Status)}",
            Category is null ? null : $"category={Uri.EscapeDataString(Category)}",
            string.IsNullOrWhiteSpace(Search) ? null : $"q={Uri.EscapeDataString(Search.Trim())}",
            page > 1 ? $"page={page}" : null
        }.Where(p => p is not null);

        return "/employee/tickets" + (parts.Any() ? "?" + string.Join('&', parts) : "");
    }

    private static string Ref(Guid id) => "TCK-" + id.ToString("N")[..8].ToUpperInvariant();

    private static string Time(DateTime utc) =>
        utc.ToString("dd MMM yyyy, HH:mm", CultureInfo.InvariantCulture) + " UTC";
}
