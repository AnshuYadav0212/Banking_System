@page "/reset-password"
@layout Layout.AuthLayout
@using Banking_System.Web.Models.Authentication
@using Banking_System.Web.Services.Authentication
@inject AuthApiClient AuthApi
@inject NavigationManager Navigation

<PageTitle>Choose a new password | SecureBank</PageTitle>

@* The link carries a secret token; never let it leak through the Referer header. *@
<HeadContent>
    <meta name="referrer" content="no-referrer" />
</HeadContent>

<div class="auth-card">
    @if (_unavailable)
    {
        <h1>Something went wrong</h1>
        <div class="alert alert-danger" role="alert">
            The banking API is unavailable. Try opening the link again in a moment.
        </div>
    }
    else if (!_linkValid)
    {
        <h1>Link expired</h1>
        <p class="text-muted">
            This password reset link is invalid, has expired, or has already been used.
        </p>
        <a href="/forgot-password" class="btn btn-primary w-100">Request a new link</a>
    }
    else
    {
        <h1>Choose a new password</h1>
        <p class="text-muted mb-4">Enter a new password for your SecureBank online-banking account.</p>

        <EditForm EditContext="_editContext" FormName="reset-password" OnValidSubmit="ResetAsync" method="post" novalidate>
            <DataAnnotationsValidator />
            <input type="hidden" name="Input.ResetId" value="@Input!.ResetId" />
            <input type="hidden" name="Input.Token" value="@Input.Token" />

            <div class="mb-3">
                <label class="form-label" for="newPassword">New password</label>
                <InputText class="form-control" id="newPassword" type="password"
                           @bind-Value="Input!.NewPassword" autocomplete="new-password" />
                <div class="form-text">Use at least 8 characters.</div>
                <ValidationMessage For="() => Input!.NewPassword" />
            </div>

            <div class="mb-3">
                <label class="form-label" for="confirmPassword">Confirm new password</label>
                <InputText class="form-control" id="confirmPassword" type="password"
                           @bind-Value="Input!.ConfirmPassword" autocomplete="new-password" />
                <ValidationMessage For="() => Input!.ConfirmPassword" />
            </div>

            <button class="btn btn-primary w-100" type="submit">Reset password</button>
        </EditForm>
    }

    <hr class="my-4" />

    <p class="mb-0 text-center">
        <a href="/login" class="text-decoration-none">Back to sign in</a>
    </p>
</div>

@code {
    [SupplyParameterFromQuery(Name = "id")]
    private string? LinkId { get; set; }

    [SupplyParameterFromQuery(Name = "token")]
    private string? LinkToken { get; set; }

    [SupplyParameterFromForm(FormName = "reset-password")]
    private ResetPasswordInput? Input { get; set; }

    private EditContext _editContext = default!;
    private bool _linkValid;
    private bool _unavailable;

    protected override async Task OnInitializedAsync()
    {
        // First visit: the id/token come from the emailed link (query string).
        // A form post: they come back in the hidden fields instead.
        var resetId = Input?.ResetId
            ?? (Guid.TryParse(LinkId, out var parsed) ? parsed : Guid.Empty);
        var token = Input?.Token ?? LinkToken ?? string.Empty;

        Input ??= new ResetPasswordInput { ResetId = resetId, Token = token };
        _editContext = new EditContext(Input);

        if (resetId == Guid.Empty || string.IsNullOrEmpty(token))
        {
            return;
        }

        try
        {
            _linkValid = await AuthApi.IsResetLinkValidAsync(resetId, token);
        }
        catch (HttpRequestException)
        {
            _unavailable = true;
        }
    }

    private async Task ResetAsync()
    {
        ApiResult<NoData> result;

        try
        {
            result = await AuthApi.ResetPasswordAsync(Input!.ResetId, Input.Token, Input.NewPassword);
        }
        catch (HttpRequestException)
        {
            _unavailable = true;
            return;
        }

        if (result.Success)
        {
            Navigation.NavigateTo("/login?reset=true");
            return;
        }

        // Expired, already used, or too many bad attempts: show the same page.
        _linkValid = false;
    }
}
