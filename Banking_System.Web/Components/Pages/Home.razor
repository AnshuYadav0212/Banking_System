@page "/"

<PageTitle>SecureBank | Online Banking</PageTitle>

@* Signed-in customers and employees land straight on their own dashboard here -
   the old separate /customer and /employee pages were merged in, so there is
   no second copy to keep in sync. Anonymous visitors and Admin (who has its
   own Admin Area instead) still see the marketing page below. *@
<AuthorizeView Roles="Customer">
    <Authorized Context="customerContext">
        <div class="container py-4 dash-page">
            <div class="dash-greeting">
                <p class="dash-eyebrow">@TimeGreeting(),</p>
                <h1>Welcome back, @Handle(customerContext.User).</h1>
            </div>

            <section class="quick-access">
                <h2>Quick access</h2>
                <p class="quick-access-sub">Jump straight to the main sections of your account.</p>

                <div class="qa-grid">
                    <a class="qa-card qa-blue" href="/account">
                        <span class="qa-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                <path d="M3 4a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v1H3V4Zm-1 3h16v7a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V7Zm3 6a1 1 0 1 0 0 2h4a1 1 0 1 0 0-2H5Z" />
                            </svg>
                        </span>
                        <span class="qa-arrow" aria-hidden="true">&rarr;</span>
                        <h3>My Account</h3>
                        <p>View your balances and account status.</p>
                    </a>

                    <a class="qa-card qa-green" href="/transfer">
                        <span class="qa-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                <path d="M2 10a8 8 0 1 1 12.9 6.32.75.75 0 1 1-.9-1.2A6.5 6.5 0 1 0 3.5 10a.75.75 0 0 1-1.5 0Zm7.47-4.53a.75.75 0 0 1 1.06 0l3 3a.75.75 0 0 1 0 1.06l-3 3a.75.75 0 1 1-1.06-1.06L11 9.94H4.75a.75.75 0 0 1 0-1.5H11L9.47 6.53a.75.75 0 0 1 0-1.06Z" />
                            </svg>
                        </span>
                        <span class="qa-arrow" aria-hidden="true">&rarr;</span>
                        <h3>Send Money</h3>
                        <p>Transfer to any SecureBank account that uses online banking.</p>
                    </a>

                    <a class="qa-card qa-purple" href="/transactions">
                        <span class="qa-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                <path d="M3 3.75A.75.75 0 0 1 3.75 3h12.5a.75.75 0 0 1 0 1.5H3.75A.75.75 0 0 1 3 3.75Zm0 4.75A.75.75 0 0 1 3.75 8h9.5a.75.75 0 0 1 0 1.5h-9.5A.75.75 0 0 1 3 8.5Zm0 4.75a.75.75 0 0 1 .75-.75h12.5a.75.75 0 0 1 0 1.5H3.75a.75.75 0 0 1-.75-.75Z" />
                            </svg>
                        </span>
                        <span class="qa-arrow" aria-hidden="true">&rarr;</span>
                        <h3>Transactions</h3>
                        <p>Search and review everything sent or received.</p>
                    </a>

                    <a class="qa-card qa-pink" href="/tickets">
                        <span class="qa-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                <path d="M2.5 5.5A1.5 1.5 0 0 1 4 4h12a1.5 1.5 0 0 1 1.5 1.5v1.75a1.75 1.75 0 0 0 0 3.5v1.75A1.5 1.5 0 0 1 16 14.5H4A1.5 1.5 0 0 1 2.5 13v-1.75a1.75 1.75 0 0 0 0-3.5V5.5Z" />
                            </svg>
                        </span>
                        <span class="qa-arrow" aria-hidden="true">&rarr;</span>
                        <h3>Support Tickets</h3>
                        <p>Raise an issue about a transaction and track it to resolution.</p>
                    </a>

                    <a class="qa-card qa-blue" href="/profile">
                        <span class="qa-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                <path d="M10 10a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm0 2c-4.42 0-8 2.24-8 5v1h16v-1c0-2.76-3.58-5-8-5Z" />
                            </svg>
                        </span>
                        <span class="qa-arrow" aria-hidden="true">&rarr;</span>
                        <h3>My Profile</h3>
                        <p>Manage your personal information and login security.</p>
                    </a>
                </div>
            </section>
        </div>
    </Authorized>
</AuthorizeView>

<AuthorizeView Roles="Employee">
    <Authorized Context="employeeContext">
        <div class="container py-4 dash-page">
            <div class="dash-greeting">
                <p class="dash-eyebrow">@TimeGreeting(),</p>
                <h1>Welcome back, @Handle(employeeContext.User).</h1>
            </div>

            <section class="quick-access">
                <h2>Quick access</h2>
                <p class="quick-access-sub">Jump straight to the main sections of the employee portal.</p>

                <div class="qa-grid">
                    <a class="qa-card qa-blue" href="/employee/customers">
                        <span class="qa-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                <path d="M10 2a4 4 0 1 1 0 8 4 4 0 0 1 0-8ZM2 16.5c0-3.038 3.582-5.5 8-5.5s8 2.462 8 5.5V17a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1v-.5Z" />
                            </svg>
                        </span>
                        <span class="qa-arrow" aria-hidden="true">&rarr;</span>
                        <h3>Customer Accounts</h3>
                        <p>Review customers and their banking accounts.</p>
                    </a>

                    <a class="qa-card qa-green" href="/employee/transactions">
                        <span class="qa-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                <path d="M6 3a1 1 0 0 1 1 1v9.59l2.3-2.3a1 1 0 1 1 1.4 1.42l-4 4a1 1 0 0 1-1.4 0l-4-4a1 1 0 1 1 1.4-1.42l2.3 2.3V4a1 1 0 0 1 1-1Zm8 14a1 1 0 0 1-1-1V6.41l-2.3 2.3a1 1 0 1 1-1.4-1.42l4-4a1 1 0 0 1 1.4 0l4 4a1 1 0 1 1-1.4 1.42L15 6.41V16a1 1 0 0 1-1 1Z" />
                            </svg>
                        </span>
                        <span class="qa-arrow" aria-hidden="true">&rarr;</span>
                        <h3>Transactions</h3>
                        <p>Review transfers and approve the ones that need it.</p>
                    </a>

                    <a class="qa-card qa-purple" href="/employee/operations">
                        <span class="qa-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                <path d="M10 1.5 3 4.5v4.3c0 4.6 2.99 8.9 7 10.2 4.01-1.3 7-5.6 7-10.2V4.5L10 1.5Zm3.7 6.5-4.24 4.24a.75.75 0 0 1-1.06 0L6.3 9.94a.75.75 0 1 1 1.06-1.06l1.58 1.58 3.7-3.7a.75.75 0 1 1 1.06 1.06Z" />
                            </svg>
                        </span>
                        <span class="qa-arrow" aria-hidden="true">&rarr;</span>
                        <h3>Banking Operations</h3>
                        <p>Freeze or unfreeze a customer's account.</p>
                    </a>

                    <a class="qa-card qa-pink" href="/employee/tickets">
                        <span class="qa-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                <path d="M2.5 5.5A1.5 1.5 0 0 1 4 4h12a1.5 1.5 0 0 1 1.5 1.5v1.75a1.75 1.75 0 0 0 0 3.5v1.75A1.5 1.5 0 0 1 16 14.5H4A1.5 1.5 0 0 1 2.5 13v-1.75a1.75 1.75 0 0 0 0-3.5V5.5Z" />
                            </svg>
                        </span>
                        <span class="qa-arrow" aria-hidden="true">&rarr;</span>
                        <h3>Ticket Queue</h3>
                        <p>Review and resolve customer support tickets.</p>
                    </a>
                </div>
            </section>
        </div>
    </Authorized>
</AuthorizeView>

<AuthorizeView Roles="Customer,Employee">
    <NotAuthorized Context="visitorContext">
        <div class="home-hero">
            <span class="home-badge">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M8 .5 1 3.5V5h14V3.5L8 .5ZM2 6v5h1.5V6H2Zm3.25 0v5h1.5V6h-1.5Zm3.25 0v5H10V6H8.5Zm3.25 0v5h1.5V6h-1.5ZM1 12v1.5h14V12H1Z" />
                </svg>
                Online Banking
            </span>

            <h1>Banking, simplified.</h1>
            <p class="home-lead">
                Send money, track every transaction and manage your accounts from one
                secure place - built around the way people actually bank.
            </p>

            <div class="home-actions">
                <AuthorizeView>
                    <Authorized Context="authContext">
                        <AuthorizeView Roles="Admin">
                            <Authorized Context="adminContext">
                                <a class="btn btn-primary" href="/admin/users">Go to admin area</a>
                            </Authorized>
                        </AuthorizeView>

                        <form method="post" action="/auth/logout" data-enhance="false">
                            <AntiforgeryToken />
                            <button class="btn btn-outline-secondary" type="submit">Logout</button>
                        </form>
                    </Authorized>
                    <NotAuthorized>
                        <a class="btn btn-primary" href="/login">Sign in</a>
                        <a class="btn btn-outline-primary" href="/register">Register as customer</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>

        <div class="home-features">
            <div class="home-feature">
                <span class="home-feature-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path d="M3.478 2.404a.75.75 0 0 0-.926.94l2.432 6.958H12.5a.75.75 0 0 1 0 1.5H4.984l-2.432 6.958a.75.75 0 0 0 .926.94 49.53 49.53 0 0 0 15.445-7.257.75.75 0 0 0 0-1.286A49.53 49.53 0 0 0 3.478 2.404Z" />
                    </svg>
                </span>
                <h2>Instant transfers</h2>
                <p>Move money between your own accounts or send it to anyone at SecureBank, with confirmation the moment it lands.</p>
            </div>

            <div class="home-feature">
                <span class="home-feature-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path d="M15.5 2A1.5 1.5 0 0 0 14 3.5v13a1.5 1.5 0 0 0 1.5 1.5h1a1.5 1.5 0 0 0 1.5-1.5v-13A1.5 1.5 0 0 0 16.5 2h-1ZM9.5 6A1.5 1.5 0 0 0 8 7.5v9A1.5 1.5 0 0 0 9.5 18h1a1.5 1.5 0 0 0 1.5-1.5v-9A1.5 1.5 0 0 0 10.5 6h-1ZM3.5 10A1.5 1.5 0 0 0 2 11.5v5A1.5 1.5 0 0 0 3.5 18h1A1.5 1.5 0 0 0 6 16.5v-5A1.5 1.5 0 0 0 4.5 10h-1Z" />
                    </svg>
                </span>
                <h2>A complete transaction history</h2>
                <p>Every transfer in one place, searchable by name and date, so you always know where your money went.</p>
            </div>

            <div class="home-feature">
                <span class="home-feature-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path d="M2.5 5.5A1.5 1.5 0 0 1 4 4h12a1.5 1.5 0 0 1 1.5 1.5v1.75a1.75 1.75 0 0 0 0 3.5v1.75A1.5 1.5 0 0 1 16 14.5H4A1.5 1.5 0 0 1 2.5 13v-1.75a1.75 1.75 0 0 0 0-3.5V5.5Z" />
                    </svg>
                </span>
                <h2>Support when you need it</h2>
                <p>Raise a ticket about any transaction and follow it through to resolution, without a single phone call.</p>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private static string TimeGreeting() => DateTime.Now.Hour switch
    {
        < 12 => "Good morning",
        < 17 => "Good afternoon",
        _ => "Good evening"
    };

    // A light personal touch using only what the sign-in cookie already carries
    // (the account's email) - no extra lookup needed.
    private static string Handle(System.Security.Claims.ClaimsPrincipal user)
    {
        var name = user.Identity?.Name;
        return string.IsNullOrWhiteSpace(name) ? "there" : name.Split('@')[0];
    }
}
