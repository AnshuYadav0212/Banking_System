@page "/"

<PageTitle>SecureBank | Online Banking</PageTitle>

<div class="home-hero">
    <span class="home-badge">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M8 .5 1 3.5V5h14V3.5L8 .5ZM2 6v5h1.5V6H2Zm3.25 0v5h1.5V6h-1.5Zm3.25 0v5H10V6H8.5Zm3.25 0v5h1.5V6h-1.5ZM1 12v1.5h14V12H1Z" />
        </svg>
        Online Banking
    </span>

    <h1>Banking, simplified.</h1>
    <p class="home-lead">
        Send money, track every transaction and manage your accounts from one
        secure place - built around the way people actually bank.
    </p>

    <div class="home-actions">
        <AuthorizeView>
            <Authorized Context="authContext">
                <AuthorizeView Roles="Customer">
                    <Authorized Context="customerContext">
                        <a class="btn btn-primary" href="/customer">Go to your dashboard</a>
                    </Authorized>
                </AuthorizeView>

                <AuthorizeView Roles="Employee">
                    <Authorized Context="employeeContext">
                        <a class="btn btn-primary" href="/employee">Go to employee dashboard</a>
                    </Authorized>
                </AuthorizeView>

                <AuthorizeView Roles="Admin">
                    <Authorized Context="adminContext">
                        <a class="btn btn-primary" href="/admin/users">Go to admin area</a>
                    </Authorized>
                </AuthorizeView>

                <form method="post" action="/auth/logout">
                    <AntiforgeryToken />
                    <button class="btn btn-outline-secondary" type="submit">Logout</button>
                </form>
            </Authorized>
            <NotAuthorized>
                <a class="btn btn-primary" href="/login">Sign in</a>
                <a class="btn btn-outline-primary" href="/register">Register as customer</a>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>

<div class="home-features">
    <div class="home-feature">
        <span class="home-feature-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path d="M3.478 2.404a.75.75 0 0 0-.926.94l2.432 6.958H12.5a.75.75 0 0 1 0 1.5H4.984l-2.432 6.958a.75.75 0 0 0 .926.94 49.53 49.53 0 0 0 15.445-7.257.75.75 0 0 0 0-1.286A49.53 49.53 0 0 0 3.478 2.404Z" />
            </svg>
        </span>
        <h2>Instant transfers</h2>
        <p>Move money between your own accounts or send it to anyone at SecureBank, with confirmation the moment it lands.</p>
    </div>

    <div class="home-feature">
        <span class="home-feature-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path d="M15.5 2A1.5 1.5 0 0 0 14 3.5v13a1.5 1.5 0 0 0 1.5 1.5h1a1.5 1.5 0 0 0 1.5-1.5v-13A1.5 1.5 0 0 0 16.5 2h-1ZM9.5 6A1.5 1.5 0 0 0 8 7.5v9A1.5 1.5 0 0 0 9.5 18h1a1.5 1.5 0 0 0 1.5-1.5v-9A1.5 1.5 0 0 0 10.5 6h-1ZM3.5 10A1.5 1.5 0 0 0 2 11.5v5A1.5 1.5 0 0 0 3.5 18h1A1.5 1.5 0 0 0 6 16.5v-5A1.5 1.5 0 0 0 4.5 10h-1Z" />
            </svg>
        </span>
        <h2>A complete transaction history</h2>
        <p>Every transfer in one place, searchable by name and date, so you always know where your money went.</p>
    </div>

    <div class="home-feature">
        <span class="home-feature-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path d="M2.5 5.5A1.5 1.5 0 0 1 4 4h12a1.5 1.5 0 0 1 1.5 1.5v1.75a1.75 1.75 0 0 0 0 3.5v1.75A1.5 1.5 0 0 1 16 14.5H4A1.5 1.5 0 0 1 2.5 13v-1.75a1.75 1.75 0 0 0 0-3.5V5.5Z" />
            </svg>
        </span>
        <h2>Support when you need it</h2>
        <p>Raise a ticket about any transaction and follow it through to resolution, without a single phone call.</p>
    </div>
</div>
