@page "/customer"
@attribute [Authorize(Roles = "Customer")]

<PageTitle>Customer | SecureBank</PageTitle>

<div class="container py-4">
    <h1>Customer Dashboard</h1>
    <p class="text-muted">Welcome to your SecureBank customer account.</p>

    <div class="row g-3 mt-2">
        <div class="col-md-6 col-lg-4">
            <div class="card h-100">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">My Account</h5>
                    <p class="card-text flex-grow-1">View your balances and account status.</p>
                    <a href="/account" class="btn btn-primary btn-sm align-self-start">View Account</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Send Money</h5>
                    <p class="card-text flex-grow-1">Transfer to any SecureBank account that uses online banking.</p>
                    <a href="/transfer" class="btn btn-primary btn-sm align-self-start">Send Money</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Transactions</h5>
                    <p class="card-text flex-grow-1">Search and review everything sent or received.</p>
                    <a href="/transactions" class="btn btn-primary btn-sm align-self-start">View Transactions</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Support Tickets</h5>
                    <p class="card-text flex-grow-1">Raise an issue about a transaction and track it to resolution.</p>
                    <a href="/tickets" class="btn btn-primary btn-sm align-self-start">View Tickets</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">My Profile</h5>
                    <p class="card-text flex-grow-1">Manage your personal information and login security.</p>
                    <a href="/profile" class="btn btn-primary btn-sm align-self-start">Manage Profile</a>
                </div>
            </div>
        </div>
    </div>
</div>
