@page "/customer"
@attribute [Authorize(Roles = "Customer")]

<PageTitle>Customer | SecureBank</PageTitle>

<div class="container py-4">
    <h1>Customer Dashboard</h1>
    <p class="text-muted">Welcome to your SecureBank customer account.</p>

    <div class="row g-3 mt-2">
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">My Account</h5>
                    <p class="card-text">View your account and banking information.</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Transactions</h5>
                    <p class="card-text">View your recent transactions.</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Profile</h5>
                    <p class="card-text">Manage your customer profile.</p>
                </div>
            </div>
        </div>
    </div>
</div>
