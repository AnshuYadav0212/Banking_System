@page "/account"
@attribute [Authorize(Roles = "Customer")]
@using System.Globalization
@using Microsoft.AspNetCore.Authentication
@using Banking_System.Web.Authentication
@using Banking_System.Web.Models.Banking
@using Banking_System.Web.Services.Banking
@inject BankingApiClient Banking

<PageTitle>My Account | SecureBank</PageTitle>

<div class="container py-4 transfer-page">
    <h1>My Account</h1>
    <p class="text-muted">Your balances and account status.</p>

    @if (_sessionExpired)
    {
        <div class="alert alert-warning" role="alert">
            Your session has expired. <a href="/login" class="alert-link">Sign in again</a> to see your accounts.
        </div>
    }
    else if (_unavailable)
    {
        <div class="alert alert-danger" role="alert">
            The banking API is unavailable. Try again in a moment.
        </div>
    }
    else if (_accounts.Count == 0)
    {
        <div class="alert alert-info" role="alert">
            You have no accounts under online banking yet.
        </div>
    }
    else
    {
        <h2 class="h5">Account overview</h2>
        <div class="account-options mb-4">
            @foreach (var account in _accounts)
            {
                <div class="account-option">
                    <div class="account-card">
                        <span class="account-card-number">@account.AccountNumber</span>
                        <span class="account-card-balance">Available balance @Money(account.AvailableBalance)</span>
                        <span class="badge @(account.IsActive ? "text-bg-success" : "text-bg-secondary") align-self-start mt-1">
                            @(account.IsActive ? "Active" : "Inactive")
                        </span>
                    </div>
                </div>
            }
        </div>

        <div class="d-flex flex-wrap gap-3">
            <a href="/transfer" class="btn btn-primary">Send money</a>
            <a href="/transactions" class="btn btn-outline-secondary">View all transactions</a>
        </div>
    }
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private List<AccountSummary> _accounts = [];
    private bool _sessionExpired;
    private bool _unavailable;

    protected override async Task OnInitializedAsync()
    {
        var token = HttpContext is null ? null : await HttpContext.GetTokenAsync(BankingTokens.AccessToken);

        if (string.IsNullOrEmpty(token))
        {
            _sessionExpired = true;
            return;
        }

        try
        {
            var result = await Banking.GetMyAccountsAsync(token);

            if (result.Error == "Unauthorized")
            {
                _sessionExpired = true;
                return;
            }

            _accounts = result.Data ?? [];
        }
        catch (HttpRequestException)
        {
            _unavailable = true;
        }
    }

    private static string Money(decimal value) =>
        "₹" + value.ToString("N2", CultureInfo.InvariantCulture);
}
