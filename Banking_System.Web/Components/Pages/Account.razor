@page "/account"
@attribute [Authorize(Roles = "Customer")]
@using System.Globalization
@using Microsoft.AspNetCore.Authentication
@using Banking_System.Web.Authentication
@using Banking_System.Web.Models.Banking
@using Banking_System.Web.Services.Banking
@inject BankingApiClient Banking

<PageTitle>My Account | SecureBank</PageTitle>

<div class="container py-4 transfer-page account-page">
    <div class="account-page-header">
        <h1>My Account</h1>
        <p class="text-muted mb-0">Your balances and account status.</p>
    </div>

    @if (_sessionExpired)
    {
        <div class="alert alert-warning" role="alert">
            Your session has expired. <a href="/login" class="alert-link">Sign in again</a> to see your accounts.
        </div>
    }
    else if (_unavailable)
    {
        <div class="alert alert-danger" role="alert">
            The banking API is unavailable. Try again in a moment.
        </div>
    }
    else if (_accounts.Count == 0)
    {
        <div class="alert alert-info" role="alert">
            You have no accounts under online banking yet.
        </div>
    }
    else
    {
        <section class="account-overview">
            <h2>Account overview</h2>

            <div class="acct-grid">
                @foreach (var account in _accounts)
                {
                    <div class="acct-card @(account.IsActive ? "" : "acct-card-inactive")">
                        <div class="acct-card-top">
                            <span class="acct-card-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                    <path d="M3 4a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v1H3V4Zm-1 3h16v7a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V7Zm3 6a1 1 0 1 0 0 2h4a1 1 0 1 0 0-2H5Z" />
                                </svg>
                            </span>
                            <span class="badge @(account.IsActive ? "text-bg-success" : "text-bg-secondary")">
                                @(account.IsActive ? "Active" : "Inactive")
                            </span>
                        </div>

                        <div class="acct-card-number">@AccountNumberMasking.Mask(account.AccountNumber)</div>

                        <div class="acct-card-balance-label">Available balance</div>
                        <div class="acct-card-balance">@Money(account.AvailableBalance)</div>
                    </div>
                }
            </div>
        </section>

        <div class="account-actions">
            <a href="/transfer" class="btn btn-primary">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path d="M2 10a8 8 0 1 1 12.9 6.32.75.75 0 1 1-.9-1.2A6.5 6.5 0 1 0 3.5 10a.75.75 0 0 1-1.5 0Zm7.47-4.53a.75.75 0 0 1 1.06 0l3 3a.75.75 0 0 1 0 1.06l-3 3a.75.75 0 1 1-1.06-1.06L11 9.94H4.75a.75.75 0 0 1 0-1.5H11L9.47 6.53a.75.75 0 0 1 0-1.06Z" />
                </svg>
                Send money
            </a>
            <a href="/transactions" class="btn btn-outline-secondary">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path d="M3 3.75A.75.75 0 0 1 3.75 3h12.5a.75.75 0 0 1 0 1.5H3.75A.75.75 0 0 1 3 3.75Zm0 4.75A.75.75 0 0 1 3.75 8h9.5a.75.75 0 0 1 0 1.5h-9.5A.75.75 0 0 1 3 8.5Zm0 4.75a.75.75 0 0 1 .75-.75h12.5a.75.75 0 0 1 0 1.5H3.75a.75.75 0 0 1-.75-.75Z" />
                </svg>
                View all transactions
            </a>
        </div>
    }
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private List<AccountSummary> _accounts = [];
    private bool _sessionExpired;
    private bool _unavailable;

    protected override async Task OnInitializedAsync()
    {
        var token = HttpContext is null ? null : await HttpContext.GetTokenAsync(BankingTokens.AccessToken);

        if (string.IsNullOrEmpty(token))
        {
            _sessionExpired = true;
            return;
        }

        try
        {
            var result = await Banking.GetMyAccountsAsync(token);

            if (result.Error == "Unauthorized")
            {
                _sessionExpired = true;
                return;
            }

            _accounts = result.Data ?? [];
        }
        catch (HttpRequestException)
        {
            _unavailable = true;
        }
    }

    private static string Money(decimal value) =>
        "₹" + value.ToString("N2", CultureInfo.InvariantCulture);
}
