@page "/tickets/new"
@attribute [Authorize(Roles = "Customer")]
@using System.Globalization
@using Microsoft.AspNetCore.Authentication
@using Banking_System.Web.Authentication
@using Banking_System.Web.Models.Banking
@using Banking_System.Web.Models.Tickets
@using Banking_System.Web.Services.Authentication
@using Banking_System.Web.Services.Banking
@using Banking_System.Web.Services.Tickets
@inject TicketApiClient Tickets
@inject BankingApiClient Banking
@inject NavigationManager Nav

<PageTitle>Raise a ticket | SecureBank</PageTitle>

<div class="container py-4 transfer-page">
    <h1>Raise a ticket</h1>
    <p class="text-muted">Tell us what happened. An employee will review it and update the ticket.</p>

    @if (_sessionExpired)
    {
        <div class="alert alert-warning" role="alert">
            Your session has expired. <a href="/login" class="alert-link">Sign in again</a> to raise a ticket.
        </div>
    }
    else
    {
        @if (_unavailable)
        {
            <div class="alert alert-danger" role="alert">
                The banking API is unavailable. Try again in a moment.
            </div>
        }

        @if (_alert is not null)
        {
            <div class="alert alert-danger" role="alert">@_alert</div>
        }

        <div class="card">
            <div class="card-body">
                <EditForm EditContext="_editContext" FormName="new-ticket" OnValidSubmit="SubmitAsync" method="post" novalidate>
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label class="form-label" for="category">Category</label>
                        <InputSelect class="form-select" id="category" @bind-Value="Input!.CategoryId">
                            @foreach (var c in TicketCategories.All)
                            {
                                <option value="@c.Id" data-requires-tx="@(TicketCategories.RequiresTransaction(c.Id) ? "true" : "false")">@c.Label</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Related transaction
                            <span class="@(TicketCategories.RequiresTransaction(Input!.CategoryId) ? "text-danger" : "text-muted")" data-tx-required-hint>
                                @(TicketCategories.RequiresTransaction(Input!.CategoryId) ? "(required for this category)" : "(optional)")
                            </span>
                        </label>

                        <details class="tx-picker" open="@(!string.IsNullOrEmpty(TransactionChoice) || _transactionError is not null)">
                            <summary class="tx-picker-summary">
                                <span class="tx-picker-summary-text @(SelectedTransaction is null ? "text-muted" : null)" data-tx-summary-text>
                                    @if (SelectedTransaction is { } selected)
                                    {
                                        @($"{selected.CounterpartyName} · {Time(selected.CreatedAt)} · {Ref(selected.TransactionId)}")
                                    }
                                    else
                                    {
                                        @:None selected - tap to search
                                    }
                                </span>
                            </summary>

                            <div class="tx-picker-panel">
                                <input type="search" class="form-control mb-2"
                                       placeholder="Search by name, date, time or reference..."
                                       autocomplete="off" data-tx-search-input />

                                <InputRadioGroup @bind-Value="TransactionChoice">
                                    <div class="tx-picker-list">
                                        <label class="tx-pick-row" data-tx-preview="None selected - tap to search">
                                            <InputRadio Value="@string.Empty" class="tx-pick-radio" />
                                            <span class="tx-main">
                                                <span class="tx-title">None</span>
                                                <span class="tx-sub">Not related to a specific transaction</span>
                                            </span>
                                        </label>
                                        @foreach (var t in _transactions)
                                        {
                                            <label class="tx-pick-row" data-tx-search="@SearchText(t)"
                                                   data-tx-preview="@($"{t.CounterpartyName} · {Time(t.CreatedAt)} · {Ref(t.TransactionId)}")">
                                                <InputRadio Value="@t.TransactionId.ToString()" class="tx-pick-radio" />
                                                <span class="tx-main">
                                                    <span class="tx-title">@t.CounterpartyName</span>
                                                    <span class="tx-sub">@Time(t.CreatedAt) &middot; @Ref(t.TransactionId)</span>
                                                </span>
                                                <span class="tx-amount @IconClass(t.Direction)">@Signed(t)</span>
                                            </label>
                                        }
                                    </div>
                                </InputRadioGroup>

                                <p class="tx-pick-empty text-muted small mb-0 mt-2" hidden>No matching transactions.</p>
                            </div>
                        </details>
                        @if (_transactionError is not null)
                        {
                            <div class="text-danger small mt-1">@_transactionError</div>
                        }
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="subject">Subject</label>
                        <InputText class="form-control" id="subject" @bind-Value="Input!.Subject" maxlength="200" />
                        <ValidationMessage For="() => Input!.Subject" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="description">Description <span class="text-muted">(optional)</span></label>
                        <InputTextArea class="form-control" id="description" @bind-Value="Input!.Description" rows="5" maxlength="2000" />
                        <ValidationMessage For="() => Input!.Description" />
                        <div class="form-text">Include amounts, dates and anything else that will help us investigate.</div>
                    </div>

                    <button class="btn btn-primary" type="submit">Submit ticket</button>
                    <a href="/tickets" class="btn btn-outline-secondary">Cancel</a>
                </EditForm>
            </div>
        </div>
    }
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [SupplyParameterFromForm(FormName = "new-ticket")]
    private CreateTicketInput? Input { get; set; }

    // A plain field bound with @bind-Value is never restored from the POST in
    // static SSR - only [SupplyParameterFromForm] properties are. This has to be
    // one of those (like Input above), not a private field, or the selected
    // transaction is silently dropped on submit.
    [SupplyParameterFromForm(FormName = "new-ticket")]
    private string? TransactionChoice { get; set; }

    private EditContext _editContext = default!;
    private string? _token;
    private List<TransactionSummary> _transactions = [];
    private string? _alert;
    private string? _transactionError;
    private bool _sessionExpired;
    private bool _unavailable;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new CreateTicketInput();
        TransactionChoice ??= Input.TransactionId?.ToString() ?? "";
        _editContext = new EditContext(Input);

        _token = HttpContext is null ? null : await HttpContext.GetTokenAsync(BankingTokens.AccessToken);

        if (string.IsNullOrEmpty(_token))
        {
            _sessionExpired = true;
            return;
        }

        try
        {
            var history = await Banking.GetHistoryAsync(_token, take: 100);

            if (history.Error == "Unauthorized")
            {
                _sessionExpired = true;
                return;
            }

            _transactions = history.Data ?? [];
        }
        catch (HttpRequestException)
        {
            _unavailable = true;
        }
    }

    private async Task SubmitAsync()
    {
        _alert = null;
        _transactionError = null;
        _unavailable = false;

        Input!.TransactionId = Guid.TryParse(TransactionChoice, out var id) ? id : null;

        if (Input.TransactionId is null && TicketCategories.RequiresTransaction(Input.CategoryId))
        {
            _transactionError = "Choose the transaction this is about - it's required for this category.";
            return;
        }

        ApiResult<CreateTicketResponse> result;

        try
        {
            result = await Tickets.CreateAsync(
                _token!,
                new CreateTicketRequest(Input.CategoryId, Input.Subject.Trim(), Input.Description?.Trim(), Input.TransactionId));
        }
        catch (HttpRequestException)
        {
            _unavailable = true;
            return;
        }

        if (result.Success && result.Data is { } created)
        {
            Nav.NavigateTo($"/tickets/{created.TicketId}");
            return;
        }

        if (result.Error == "Unauthorized")
        {
            _sessionExpired = true;
            return;
        }

        if (result.Error == "TransactionRequired")
        {
            _transactionError = "Choose the transaction this is about - it's required for this category.";
            return;
        }

        _alert = result.Error switch
        {
            "TransactionNotFound" => "That transaction could not be found on one of your accounts. Choose another, or leave it blank.",
            _ => "Some of the details are not valid. Please review the form and try again."
        };
    }

    private TransactionSummary? SelectedTransaction =>
        _transactions.FirstOrDefault(t => t.TransactionId.ToString() == TransactionChoice);

    // What the search box matches against: name, date, time, then reference -
    // one lowercase string is enough since "contains" already matches any of them.
    private string SearchText(TransactionSummary t) =>
        (t.CounterpartyName + " " + Time(t.CreatedAt) + " " + Ref(t.TransactionId)).ToLowerInvariant();

    private static string Ref(Guid transactionId) => "SB-" + transactionId.ToString("N")[..8].ToUpperInvariant();

    private static string Money(decimal value) => "₹" + value.ToString("N2", CultureInfo.InvariantCulture);

    private static string Signed(TransactionSummary item) => item.Direction switch
    {
        "Sent" => "-" + Money(item.Amount),
        "Received" => "+" + Money(item.Amount),
        _ => Money(item.Amount)
    };

    private static string IconClass(string direction) => direction switch
    {
        "Sent" => "tx-out",
        "Received" => "tx-in",
        _ => "tx-own"
    };

    private static string Time(DateTime utc) => utc.ToString("dd MMM yyyy, HH:mm", CultureInfo.InvariantCulture) + " UTC";
}
