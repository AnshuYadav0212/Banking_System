@inherits LayoutComponentBase

<div class="auth-page">
    <div class="auth-brand-panel">
        <div class="auth-brand">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                <path d="M8 .5 1 3.5V5h14V3.5L8 .5ZM2 6v5h1.5V6H2Zm3.25 0v5h1.5V6h-1.5Zm3.25 0v5H10V6H8.5Zm3.25 0v5h1.5V6h-1.5ZM1 12v1.5h14V12H1Z" />
            </svg>
            <span>SecureBank</span>
        </div>

        <h2 class="auth-tagline">Online banking that stays out of your way.</h2>
        <p class="auth-subtagline">Send money, track every transaction, and get help - all in one place.</p>

        <ul class="auth-feature-list">
            <li>
                <span class="auth-feature-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 1.5 3 4v5.2c0 4.4 3 8.2 7 9.3 4-1.1 7-4.9 7-9.3V4l-7-2.5Zm-1.1 11.1L5.8 9.5l1.1-1.1 2 2 4.2-4.2 1.1 1.1-5.3 5.3Z" /></svg>
                </span>
                <div>
                    <strong>Bank-grade security</strong>
                    <span>Every transfer is verified and rate-limited to protect your account.</span>
                </div>
            </li>
            <li>
                <span class="auth-feature-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M2 10a8 8 0 1 1 12.9 6.32.75.75 0 1 1-.9-1.2A6.5 6.5 0 1 0 3.5 10a.75.75 0 0 1-1.5 0Zm7.47-4.53a.75.75 0 0 1 1.06 0l3 3a.75.75 0 0 1 0 1.06l-3 3a.75.75 0 1 1-1.06-1.06L11 9.94H4.75a.75.75 0 0 1 0-1.5H11L9.47 6.53a.75.75 0 0 1 0-1.06Z" /></svg>
                </span>
                <div>
                    <strong>Instant transfers</strong>
                    <span>Send money to any SecureBank customer and see it confirmed right away.</span>
                </div>
            </li>
            <li>
                <span class="auth-feature-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M2.5 5.5A1.5 1.5 0 0 1 4 4h12a1.5 1.5 0 0 1 1.5 1.5v1.75a1.75 1.75 0 0 0 0 3.5v1.75A1.5 1.5 0 0 1 16 14.5H4A1.5 1.5 0 0 1 2.5 13v-1.75a1.75 1.75 0 0 0 0-3.5V5.5Z" /></svg>
                </span>
                <div>
                    <strong>Real support, tracked</strong>
                    <span>Raise a ticket about any transaction and follow it through to resolution.</span>
                </div>
            </li>
        </ul>

        <p class="auth-footer auth-footer-panel">&copy; @DateTime.Now.Year SecureBank. Your security is our priority.</p>
    </div>

    <div class="auth-content">
        @Body
        <p class="auth-footer auth-footer-mobile">&copy; @DateTime.Now.Year SecureBank. Your security is our priority.</p>
    </div>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
